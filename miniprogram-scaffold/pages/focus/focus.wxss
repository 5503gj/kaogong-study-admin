.page { padding: 32rpx; }
.tip { color: #64748b; font-size: 26rpx; margin-bottom: 24rpx; }
.form { display: flex; flex-direction: column; gap: 20rpx; }
.inp { border: 1rpx solid #cbd5e1; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; background: #fff; }
.row { display: flex; align-items: center; gap: 16rpx; font-size: 28rpx; }
.small { width: 140rpx; text-align: center; }
.btn { background: #4f46e5; color: #fff; border-radius: 12rpx; font-size: 30rpx; margin-top: 10rpx; }
.btn.danger { background: #dc2626; }

.history { margin-top: 40rpx; }
.h-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.empty { color: #94a3b8; font-size: 26rpx; }
.h-item { display: flex; justify-content: space-between; font-size: 26rpx; padding: 12rpx 0; border-bottom: 1rpx solid #e2e8f0; }
.muted { color: #94a3b8; }

.running { display: flex; flex-direction: column; align-items: center; gap: 24rpx; padding-top: 80rpx; }
.subj { font-size: 30rpx; color: #334155; }
.clock { font-size: 120rpx; font-weight: 700; font-family: monospace; }
.meta { font-size: 26rpx; color: #64748b; }
.hint { font-size: 24rpx; color: #94a3b8; margin-top: 10rpx; }

.summary { display: flex; flex-direction: column; gap: 24rpx; padding-top: 40rpx; }
.s-title { font-size: 32rpx; font-weight: 700; text-align: center; }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.cell { flex: 1; min-width: 40%; border: 1rpx solid #e2e8f0; border-radius: 12rpx; padding: 24rpx; text-align: center; background: #fff; }
.num { font-size: 44rpx; font-weight: 700; }
.lab { font-size: 24rpx; color: #64748b; margin-top: 6rpx; }
.verdict { border-radius: 12rpx; padding: 20rpx; font-size: 27rpx; }
.verdict.good { background: #ecfdf5; color: #047857; }
.verdict.warn { background: #fef2f2; color: #b91c1c; }
