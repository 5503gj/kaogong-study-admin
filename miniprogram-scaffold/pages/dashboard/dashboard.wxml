<view class="page">
  <view class="cards">
    <view class="card">
      <text class="k">累计学习</text>
      <text class="v">{{stats.totalHours}} 小时</text>
      <text class="h">共 {{stats.sessionCount}} 次</text>
    </view>
    <view class="card">
      <text class="k">学习天数</text>
      <text class="v">{{stats.studyDays}} 天</text>
      <text class="h">日均 {{stats.avgMinutesPerActiveDay}} 分</text>
    </view>
    <view class="card">
      <text class="k">近 7 天</text>
      <text class="v">{{stats.last7Minutes}} 分</text>
      <text class="h">近 30 天 {{stats.last30Minutes}} 分</text>
    </view>
    <view class="card">
      <text class="k">待学完成</text>
      <text class="v">{{stats.todoDone}}/{{stats.todoTotal}}</text>
      <text class="h">进行中 {{stats.todoDoing}}</text>
    </view>
  </view>

  <view class="section">
    <text class="sec-title">学科占比</text>
    <view class="subject" wx:for="{{stats.bySubject}}" wx:key="subject">
      <text class="sname">{{item.subject}}</text>
      <text class="sval">{{item.minutes}} 分 · {{item.count}} 次</text>
    </view>
  </view>

  <view class="tip">📈 趋势图可引入 ec-canvas（ECharts）渲染，详见《小程序迁移指南》。</view>
</view>
