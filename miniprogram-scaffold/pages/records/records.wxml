<view class="page">
  <view class="head">
    <text class="title">学习记录</text>
    <button class="btn" size="mini" bindtap="toggleForm">{{ showForm ? '收起' : '新增记录' }}</button>
  </view>

  <view class="form" wx:if="{{showForm}}">
    <input class="input" placeholder="日期 (YYYY-MM-DD)" value="{{form.date}}" bindinput="onDate" />
    <input class="input" placeholder="科目" value="{{form.subject}}" bindinput="onSubject" />
    <input class="input" placeholder="学习内容" value="{{form.title}}" bindinput="onTitle" />
    <input class="input" type="number" placeholder="时长 (分钟)" value="{{form.duration}}" bindinput="onDuration" />
    <button class="btn primary" bindtap="save">保存</button>
  </view>

  <view class="list">
    <view class="item" wx:for="{{sessions}}" wx:key="id">
      <view class="info">
        <text class="s">{{item.subject}}</text>
        <text class="t">{{item.title}}</text>
        <text class="m">{{item.date}} · {{item.duration}} 分钟</text>
      </view>
      <text class="del" bindtap="del" data-id="{{item.id}}">删除</text>
    </view>
    <view class="empty" wx:if="{{sessions.length === 0}}">暂无记录，点右上角新增</view>
  </view>
</view>
